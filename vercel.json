{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/game.py": {
      "maxDuration": 15,
      "includeFiles": "co_xam/**",
      "excludeFiles": "{tests/**,web/**,dist/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
